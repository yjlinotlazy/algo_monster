[
  {
    "name": "empty array",
    "code": "result = length_of_lis([])\nassert result == 0"
  },
  {
    "name": "single element",
    "code": "result = length_of_lis([1])\nassert result == 1"
  },
  {
    "name": "already sorted",
    "code": "result = length_of_lis([1, 2, 3, 4, 5])\nassert result == 5"
  },
  {
    "name": "strictly decreasing",
    "code": "result = length_of_lis([5, 4, 3, 2, 1])\nassert result == 1"
  },
  {
    "name": "classic example — [10,9,2,5,3,7,101,18]",
    "code": "result = length_of_lis([10, 9, 2, 5, 3, 7, 101, 18])\nassert result == 4"
  },
  {
    "name": "all same elements — strictly increasing requires unique",
    "code": "result = length_of_lis([2, 2, 2, 2])\nassert result == 1"
  },
  {
    "name": "two elements ascending",
    "code": "result = length_of_lis([1, 3])\nassert result == 2"
  },
  {
    "name": "two elements descending",
    "code": "result = length_of_lis([3, 1])\nassert result == 1"
  },
  {
    "name": "longer LIS needs non-greedy picks",
    "code": "result = length_of_lis([0, 1, 0, 3, 2, 3])\nassert result == 4"
  },
  {
    "name": "alternating up and down",
    "code": "result = length_of_lis([3, 5, 2, 7, 1, 8])\nassert result == 4"
  }
]
